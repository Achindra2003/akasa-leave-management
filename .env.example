# Copy to .env (never commit .env). Read by docker compose and the backend.

# --- AI (optional) -------------------------------------------------------------
# Leave LLM_API_KEY empty to use the deterministic offline demo model.
LLM_PROVIDER=groq                 # groq | openai_compat | fake
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# For openai_compat (OpenAI, OpenRouter, Ollama, vLLM, Gemini/Anthropic compat):
# LLM_BASE_URL=https://api.openai.com/v1

# --- Security --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
