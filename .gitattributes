# Shell scripts and container files must keep LF endings on every platform,
# or Linux containers fail with "exec ./docker-entrypoint.sh: no such file or directory".
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf
*.png binary
*.pdf binary
*.zip binary
